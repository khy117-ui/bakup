<?xml version="1.0" encoding="utf-8"?>
<!--
  굿배송항공 요금표 관리 페이지(/admin/) 외부 접근 제한 — IIS (Windows 호스팅, 기존 postgood.co.kr 과 같은 환경)
  - IP 및 도메인 제한: 허용 IP 이외에는 모두 차단 (IIS 역할 서비스 "IP 및 도메인 제한" 설치 필요)
  - 기본 인증: 익명 접근을 막고 관리자 Windows 계정 또는 IIS 관리자 계정으로만 로그인
  ※ 공개 요금표가 읽는 /assets/data/rates.xlsx 는 이 폴더 밖에 있으므로 영향을 받지 않습니다.
-->
<configuration>
  <system.webServer>
    <security>
      <!-- 허용 IP 목록: 사무실 고정 IP로 교체하세요. -->
      <ipSecurity allowUnlisted="false" denyAction="NotFound">
        <clear />
        <add ipAddress="127.0.0.1" allowed="true" />
        <add ipAddress="61.43.120.209" allowed="true" />
        <add ipAddress="117.110.98.252" allowed="true" />
        <add ipAddress="175.209.40.226" allowed="true" />
        <add ipAddress="211.206.111.242" allowed="true" />
        <add ipAddress="221.151.149.0" subnetMask="255.255.255.0" allowed="true" />
      </ipSecurity>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <basicAuthentication enabled="true" realm="GOODPOST 요금표 관리" />
      </authentication>
      <!-- 업로드 파일 크기 상한 5MB -->
      <requestFiltering>
        <requestLimits maxAllowedContentLength="5242880" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="noindex, nofollow" />
        <add name="Cache-Control" value="no-store" />
      </customHeaders>
    </httpProtocol>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
