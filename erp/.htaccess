# 디렉터리 목록 노출 방지
Options -Indexes

# 소스·업로드 폴더 차단 (Apache 일 때. nginx 면 무시되므로 PHP 가드가 따로 있습니다)
# 앞에 ^ 를 붙이지 않습니다 — /erp/ 같은 하위 폴더에 올려도 /erp/sql/… 이 막혀야 합니다.
# (^/ 로 쓰면 사이트 맨 위에 올렸을 때만 막히고, 하위 폴더에서는 전부 열립니다)
RedirectMatch 404 /(app|tools|storage|sql)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# PHP 설정 파일은 웹에서 안 보이게
<Files ".user.ini">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</Files>

# PHP 한도 · 오류 표시 — 이 서버는 Apache 모듈(mod_php)이라 .user.ini 를 안 읽습니다 (2026-09-19 확인: 한도 64MB 그대로)
# 모듈이 없는 서버(PHP-FPM)에서는 이 묶음이 통째로 무시되고 .user.ini 가 쓰입니다
<IfModule mod_php.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 210M
  php_value max_file_uploads 30
  php_value max_execution_time 300
  php_value max_input_time 300
  php_flag display_errors off
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 210M
  php_value max_file_uploads 30
  php_value max_execution_time 300
  php_value max_input_time 300
  php_flag display_errors off
</IfModule>
